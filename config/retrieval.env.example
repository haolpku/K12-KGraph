# Copy this file to config/retrieval.env and replace placeholder values.
# Do not commit config/retrieval.env.

COMPOSE_PROJECT_NAME=k12-kgraph-retrieval-e2e

# Neo4j 5.26 LTS
NEO4J_IMAGE=neo4j:5.26
NEO4J_HOST=127.0.0.1
# Use non-default host ports so an existing Neo4j Browser or local service
# cannot connect to the isolated E2E database with stale credentials.
NEO4J_PORT=17687
NEO4J_HTTP_PORT=17474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_PLUGINS=[]
# Research E2E uses Community and application read-only enforcement.
# Production must provide a separate Enterprise/Aura read-only principal.
NEO4J_READONLY_USER=
NEO4J_READONLY_PASSWORD=
K12_NEO4J_POOL_WARMUP_CONCURRENCY=8

# API container
RETRIEVAL_API_PORT=18000
RETRIEVAL_API_APP=retrieval.api:app
RETRIEVAL_API_WORKERS=1
RETRIEVAL_LOG_LEVEL=info
K12_RETRIEVAL_HYBRID_BACKEND=graphrag
K12_ENV=development
K12_AUTH_MODE=development
K12_ROUTER_MODE=cascade
K12_AUDIT_HMAC_KEY=
K12_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Free-form Text2Cypher is retired from API runtime wiring.
K12_TEXT2CYPHER_ENABLED=false

# Structured routing and TeacherAnalysisPlan. Keep the key only in the local
# config/retrieval.env file and rotate it if it has ever been pasted or logged.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# Data import
KG_JSON_PATH=data/retrieval/primary_math_graph.json
KG_SUBJECT=数学
KG_STAGE=小学
KG_EDITION=人教版

# Credential-free E2E reuses the graph's 512-dimensional BGE vectors and the
# matching local model. To test DashScope, switch the provider to openai,
# set EMBEDDING_API_KEY locally, use text-embedding-v4, and regenerate all
# vectors with docker/scripts/generate_vectors.py --replace.
KG_DROP_EMBEDDINGS=false
K12_RETRIEVAL_EMBEDDING_PROVIDER=fastembed
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
VECTOR_BATCH_SIZE=10
